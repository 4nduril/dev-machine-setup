[core]
	editor = vim
	autocrlf = false
[merge]
	tool = vimdiff
[push]
	default = simple
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
