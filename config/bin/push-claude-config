#!/usr/bin/env bash
# Push the local Claude Code user config to remote boxes over SSH: the
# global ~/.claude/CLAUDE.md, plus the ~/.claude/rules/ and ~/.claude/skills/
# directories. This machine is the source of truth; both directories are
# mirrored, so entries that only exist on the target are removed. The
# target's other ~/.claude content (settings, sessions, projects, plugins)
# is not touched.
#
# Mirroring makes this the only writer of those two directories on a target.
# Anything else that populates them, such as a Coder dotfiles layer
# symlinking users/<login>/claude/skills/ into ~/.claude/skills/, will have
# its entries deleted here. Pick one mechanism per directory.
#
# `skills/synced/` is the exception and stays excluded. Claude Code downloads
# the account's own skill bundle there on every machine it runs on, so pushing
# it would mean two writers for one tree: the copies differ per machine, rsync
# resends them on every run, and --delete removes a bundle the target fetched
# under a different id. Excluded paths are also protected from --delete, so a
# target keeps whatever it downloaded for itself.
set -euo pipefail

usage() {
  printf 'Usage: push-claude-config [-n] <ssh-host> [<ssh-host>...]\n'
  printf '\n'
  printf '  -n, --dry-run  Show what would change without transferring.\n'
}

dry_run=()
hosts=()
for arg in "$@"; do
  case "$arg" in
    -n | --dry-run) dry_run=(--dry-run) ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      printf 'error: unknown option: %s\n' "$arg" >&2
      exit 1
      ;;
    *) hosts+=("$arg") ;;
  esac
done

if ((${#hosts[@]} == 0)); then
  usage >&2
  exit 1
fi

for host in "${hosts[@]}"; do
  printf '==> %s\n' "$host"
  if ((${#dry_run[@]} == 0)); then
    ssh "$host" 'mkdir -p ~/.claude/rules ~/.claude/skills'
  fi
  rsync "${dry_run[@]}" -ai "$HOME/.claude/CLAUDE.md" "$host:.claude/CLAUDE.md"
  rsync "${dry_run[@]}" -ai --delete "$HOME/.claude/rules/" "$host:.claude/rules/"
  rsync "${dry_run[@]}" -ai --delete --exclude 'synced/' "$HOME/.claude/skills/" "$host:.claude/skills/"
done
