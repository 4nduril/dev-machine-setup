#!/usr/bin/env bash
# Push the local Claude Code user config to remote boxes over SSH: the
# global ~/.claude/CLAUDE.md, plus the ~/.claude/rules/ and ~/.claude/skills/
# directories. This machine is the source of truth; both directories are
# mirrored, so entries that only exist on the target are removed. The
# target's other ~/.claude content (settings, sessions, projects, plugins)
# is not touched, with one exception below.
#
# From ~/.claude/settings.json only `cleanupPeriodDays` is copied, into the
# target's settings.json, leaving every other key there as it is. Claude Code
# deletes session transcripts older than that many days (default 30) when it
# starts, and usage tools read token counts from those transcripts. The rest
# of settings.json holds per-machine choices, so it is not pushed. A local
# value of 0 is not copied, because Claude Code reads 0 as "delete every
# transcript and stop writing new ones".
#
# Mirroring deletes target entries that do not exist here, except for these,
# which are excluded and therefore also protected from --delete:
#
# - Symlinks in skills/ or rules/ that point into the Coder dotfiles layer
#   (~/.config/coderv2/dotfiles/). The layer links its shared skills there on
#   every workspace start, so it owns those entries on that target.
# - `skills/synced/`. Claude Code downloads the account's own skill bundle
#   there on every machine it runs on, so pushing it would mean two writers
#   for one tree: the copies differ per machine, rsync resends them on every
#   run, and --delete removes a bundle the target fetched under a different id.
# - `skills/.trash/`. Claude Code moves removed skills there; it is per
#   machine and nothing reads it.
set -euo pipefail

usage() {
  printf 'Usage: push-claude-config [-n] <ssh-host> [<ssh-host>...]\n'
  printf '\n'
  printf '  -n, --dry-run  Show what would change without transferring.\n'
}

dry_run=()
hosts=()
for arg in "$@"; do
  case "$arg" in
    -n | --dry-run) dry_run=(--dry-run) ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      printf 'error: unknown option: %s\n' "$arg" >&2
      exit 1
      ;;
    *) hosts+=("$arg") ;;
  esac
done

if ((${#hosts[@]} == 0)); then
  usage >&2
  exit 1
fi

retention_days=""
if [[ -f "$HOME/.claude/settings.json" ]]; then
  retention_days=$(jq -r '.cleanupPeriodDays // empty' "$HOME/.claude/settings.json")
fi
if [[ -n "$retention_days" && ! "$retention_days" =~ ^[1-9][0-9]*$ ]]; then
  printf 'warning: local cleanupPeriodDays is %s, not a positive integer; not copying it\n' "$retention_days" >&2
  retention_days=""
fi

# Runs on the target. $1 is the day count, $2 is 1 for a dry run.
# shellcheck disable=SC2016 # expanded by the remote bash, not here
set_retention='
set -euo pipefail
f="$HOME/.claude/settings.json"
if ! command -v jq >/dev/null; then
  printf "error: jq is not installed on the target\n" >&2
  exit 1
fi
current=""
if [[ -f "$f" ]]; then
  current=$(jq -r ".cleanupPeriodDays // empty" "$f")
fi
[[ "$current" == "$1" ]] && exit 0
printf "settings.json: cleanupPeriodDays %s -> %s\n" "${current:-unset}" "$1"
[[ "$2" == 1 ]] && exit 0
[[ -f "$f" ]] || printf "{}\n" >"$f"
tmp=$(mktemp)
jq --argjson days "$1" ".cleanupPeriodDays = \$days" "$f" >"$tmp"
cat "$tmp" >"$f"
rm "$tmp"
'

# Runs on the target. Prints each skills/ and rules/ entry that is a symlink
# into the Coder dotfiles layer, as <dir>/<name>.
# shellcheck disable=SC2016 # expanded by the remote bash, not here
list_layer_links='
for d in skills rules; do
  [[ -d "$HOME/.claude/$d" ]] || continue
  find "$HOME/.claude/$d" -mindepth 1 -maxdepth 1 -type l \
    -lname "$HOME/.config/coderv2/dotfiles/*" -printf "$d/%f\n"
done
'

# $1 is skills or rules, the rest are <dir>/<name> entries. Prints an anchored
# rsync exclude for each entry in that dir.
excludes_for() {
  local dir=$1
  shift
  printf '%s\n' "$@" | sed -n "s|^$dir/\(.\+\)$|--exclude=/\1|p"
}

for host in "${hosts[@]}"; do
  printf '==> %s\n' "$host"
  if ((${#dry_run[@]} == 0)); then
    ssh "$host" 'mkdir -p ~/.claude/rules ~/.claude/skills'
  fi
  mapfile -t layer_links < <(ssh "$host" bash -s <<<"$list_layer_links")
  if ((${#layer_links[@]} > 0)); then
    printf 'keeping dotfiles-layer link: %s\n' "${layer_links[@]}"
  fi
  mapfile -t rules_excludes < <(excludes_for rules "${layer_links[@]}")
  mapfile -t skills_excludes < <(excludes_for skills "${layer_links[@]}")
  rsync "${dry_run[@]}" -ai "$HOME/.claude/CLAUDE.md" "$host:.claude/CLAUDE.md"
  rsync "${dry_run[@]}" -ai --delete "${rules_excludes[@]}" "$HOME/.claude/rules/" "$host:.claude/rules/"
  rsync "${dry_run[@]}" -ai --delete --exclude 'synced/' --exclude '.trash/' "${skills_excludes[@]}" \
    "$HOME/.claude/skills/" "$host:.claude/skills/"
  if [[ -n "$retention_days" ]]; then
    ssh "$host" bash -s -- "$retention_days" "$((${#dry_run[@]} > 0 ? 1 : 0))" <<<"$set_retention"
  fi
done
